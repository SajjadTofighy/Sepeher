    "api:generate": "openapi-typescript openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.2.5",
    "@tanstack/react-query": "5.83.0",
    "@tanstack/react-table": "8.21.3",
    "echarts": "5.6.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "5.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "openapi-typescript": "7.9.1",
    "prettier": "3.5.3",
    "swagger-ui-dist": "5.27.1",
    "typescript": "5.9.2",
    "vite": "6.3.5"
