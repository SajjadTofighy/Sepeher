{
  "realm": "sepehr",
  "enabled": true,
  "displayName": "Sepehr Command",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fa",
    "en"
  ],
  "defaultLocale": "fa",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 46800,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1)",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "guard"
      },
      {
        "name": "shift_supervisor",
        "composite": true,
        "composites": {
          "realm": [
            "sepehr-mfa-required"
          ]
        }
      },
      {
        "name": "security_officer",
        "composite": true,
        "composites": {
          "realm": [
            "sepehr-mfa-required"
          ]
        }
      },
      {
        "name": "security_manager",
        "composite": true,
        "composites": {
          "realm": [
            "sepehr-mfa-required"
          ]
        }
      },
      {
        "name": "auditor",
        "composite": true,
        "composites": {
          "realm": [
            "sepehr-mfa-required"
          ]
        }
      },
      {
        "name": "admin",
        "composite": true,
        "composites": {
          "realm": [
            "sepehr-mfa-required"
          ]
        }
      },
      {
        "name": "sepehr-mfa-required",
        "description": "Internal composite target for mandatory MFA"
      }
    ]
  },
  "groups": [
    {
      "name": "zones"
    },
    {
      "name": "contractors"
    }
  ],
  "clients": [
    {
      "clientId": "sepehr-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8000/auth/callback",
        "http://127.0.0.1:5173/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8000",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:8000/##http://127.0.0.1:5173/"
      },
      "protocolMappers": [
        {
          "name": "sepehr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sepehr-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sepehr-field",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8000/auth/callback",
        "http://127.0.0.1:5173/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8000",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client.session.max.lifespan": "46800",
        "post.logout.redirect.uris": "http://127.0.0.1:8000/##http://127.0.0.1:5173/"
      },
      "protocolMappers": [
        {
          "name": "sepehr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sepehr-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sepehr-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "sepehr-audit",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
      "username": "service-account-sepehr-audit",
      "enabled": true,
      "serviceAccountClientId": "sepehr-audit",
      "clientRoles": {
        "realm-management": [
          "view-events"
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "sepehr-browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "flowAlias": "sepehr-identify"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "sepehr-required-mfa"
        }
      ]
    },
    {
      "alias": "sepehr-identify",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie"
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "sepehr-password"
        }
      ]
    },
    {
      "alias": "sepehr-password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "sepehr-required-mfa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sepehr-mfa-role"
        },
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sepehr-mfa-role",
      "config": {
        "condUserRole": "sepehr-mfa-required",
        "condNegate": "false"
      }
    }
  ],
  "browserFlow": "sepehr-browser",
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none'; default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "xRobotsTag": "none",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains",
    "referrerPolicy": "no-referrer"
  },
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "sepehr-audit",
        "roles": [
          "view-events"
        ]
      }
    ]
  }
}
