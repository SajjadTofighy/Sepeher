# Local development only. npm run docker:init generates private random passwords.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Override with approved internal registry images, preferably pinned by digest.
SEPEHR_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4
SEPEHR_POSTGRES_IMAGE=postgres:17.6-alpine
SEPEHR_AUTH_MODE=keycloak
SEPEHR_AUTH_ENFORCE_ALL=false
SEPEHR_OIDC_ISSUER=http://127.0.0.1:8080/realms/sepehr
# Only explicitly approved internal resource origins, space separated for CSP.
SEPEHR_RESOURCE_ORIGINS=http://127.0.0.1:8080
SEPEHR_GIS_ORIGINS=
SEPEHR_FIELD_TAG_BASE_URL=http://127.0.0.1:8000/nfc
# npm run keycloak:audit writes this secret into .env without displaying it.
SEPEHR_AUDIT_CLIENT_SECRET=
